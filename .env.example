# Copy to .env and replace placeholders with values from Neon and Redis Cloud.
# This file contains no live credentials.

# Neon PostgreSQL application connection. Use the pooled connection string
# from Neon and preserve sslmode=require in its query parameters.
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-application-username>
SPRING_DATASOURCE_PASSWORD=<neon-application-password>

# Redis Cloud connection. TLS is enabled by default in the production profile.
SPRING_DATA_REDIS_HOST=<redis-cloud-host>
SPRING_DATA_REDIS_PORT=<redis-cloud-port>
SPRING_DATA_REDIS_USERNAME=default
SPRING_DATA_REDIS_PASSWORD=<redis-cloud-password>

# Production-only required origins. Use comma-separated HTTPS origins, no paths.
TRADECORE_CORS_ALLOWED_ORIGINS=https://<your-frontend-host>
TRADECORE_WEBSOCKET_ALLOWED_ORIGINS=https://<your-frontend-host>

# Optional production tuning. Keep the CIDRs limited to the direct proxy addresses.
SPRING_DATA_REDIS_SSL_ENABLED=true
TRADECORE_SECURITY_TRUSTED_PROXY_CIDRS=<proxy-ip-or-cidr>
TRADECORE_DB_POOL_MAX_SIZE=10
TRADECORE_DB_POOL_MIN_IDLE=2
TRADECORE_SHUTDOWN_TIMEOUT=30s
TRADECORE_NSE_MCP_CONNECT_TIMEOUT=PT5S
TRADECORE_NSE_MCP_REQUEST_TIMEOUT=PT12S
TRADECORE_EXECUTION_INTERVAL=PT5S
TRADECORE_INTRADAY_SQUARE_OFF_CHECK_INTERVAL=PT30S
TRADECORE_MARKET_DATA_QUOTE_REFRESH_INTERVAL=PT5M
TRADECORE_MARKET_DATA_CANDLE_REFRESH_CRON=0 0 18 * * MON-FRI

# Basic Spring Security foundation; use a long unique password.
TRADECORE_SECURITY_USER=tradecore-dev
TRADECORE_SECURITY_PASSWORD=<replace-with-a-long-unique-password>

# Backend local port
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=production

# Set this to false when using the production profile; production disables the development user itself.
TRADECORE_SECURITY_DEV_USER_ENABLED=false
