# Copy to .env and replace every placeholder before local use.

# PostgreSQL (used by compose.yaml and the backend)
POSTGRES_DB=tradecore
POSTGRES_USER=tradecore
POSTGRES_PASSWORD=replace-with-a-local-password

# Redis (used by compose.yaml and the backend)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Basic Spring Security foundation; use a long unique local password.
TRADECORE_SECURITY_USER=tradecore-dev
TRADECORE_SECURITY_PASSWORD=replace-with-a-long-local-password

# Backend local port
SERVER_PORT=8080
